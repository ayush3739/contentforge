# ==============================================================================
# ContentForge AI — Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit `.env` to Git!
# All local values below match the working docker-compose.yml services.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=contentforge
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# Local Docker: postgresql://postgres:postgres@localhost:5432/contentforge
# For shared team DB, replace with the team PostgreSQL connection string.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contentforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# REDIS (cache, background jobs, rate-limit state)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# OBJECT STORAGE (S3-compatible / MinIO locally)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=contentforge-artifacts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# AUTH (JWT) — P5 provides config contract, P3 implements the auth endpoints
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# AI / LLM (owned by P1 — P5 only passes these through as config)
# Options: gemini, openai, anthropic, ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004
VECTOR_DIMENSION=768

# ------------------------------------------------------------------------------
# BLOCKCHAIN / PROVENANCE LEDGER (owned by P5)
# PROVENANCE_LEDGER_MOCK=true means hashes are computed and stored locally
# instead of anchored to a real Hyperledger Fabric network.
# ------------------------------------------------------------------------------
BLOCKCHAIN_NETWORK=hyperledger-fabric
BLOCKCHAIN_RPC_URL=grpc://localhost:7051
BLOCKCHAIN_CONTRACT_ID=contentforge_provenance
PROVENANCE_LEDGER_MOCK=true

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
