# ==============================================================================
# ContentForge AI — Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit `.env` to Git!
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=contentforge
LOG_LEVEL=INFO
DEBUG=true

# API & Gateway Settings
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security & Authentication (JWT)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL + pgvector)
# For local Docker: postgresql://postgres:postgres@localhost:5432/contentforge
# For shared team DB: replace with team PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contentforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Background Jobs (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / Supabase / MinIO)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=contentforge-artifacts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# AI / LLM Configuration (P1)
# Options: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004
VECTOR_DIMENSION=768

# Blockchain / Provenance Ledger (P5)
BLOCKCHAIN_NETWORK=hyperledger-fabric
BLOCKCHAIN_RPC_URL=grpc://localhost:7051
BLOCKCHAIN_CONTRACT_ID=contentforge_provenance
PROVENANCE_LEDGER_MOCK=true
