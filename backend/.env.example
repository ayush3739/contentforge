# ==============================================================================
# ContentForge AI — Backend Environment Configuration Template (.env.example)
# Copy this file to `.env` in this directory (`backend/.env`).
# NEVER commit `.env` containing sensitive production secrets to Git!
# ==============================================================================

# Application & API
APP_ENV=development
DEBUG=true
PROJECT_NAME="ContentForge AI"
SECRET_KEY=contentforge-dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Database: PostgreSQL + pgvector (Neon Serverless PostgreSQL recommended)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:your-password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Redis: Upstash Cloud Redis (Only Upstash — No local Docker required)
# ------------------------------------------------------------------------------
# Option A: Connection string (Supports RQ background queues and Redis Pub/Sub)
REDIS_URL=rediss://default:your-upstash-token@rational-spaniel-128059.upstash.io:6379

# Option B: Upstash REST API Credentials (Direct REST client & auto-synthesized TCP)
UPSTASH_REDIS_REST_URL=https://rational-spaniel-128059.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ------------------------------------------------------------------------------
# Primary AI Provider: Groq (Multi-account round-robin, rate-limit failover & fallback models)
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_first_groq_api_key_here
GROQ_API_KEY_SECOND=gsk_your_second_groq_api_key_here  # Account 2: round-robin & 429 failover
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_SECOND_FALLBACK_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# Secondary AI Provider: xAI Grok (Grok-2 with multi-tier fallbacks)
# ------------------------------------------------------------------------------
GROK_API_KEY=xai-your-grok-api-key-here
GROK_MODEL=grok-2-latest
GROK_FALLBACK_MODEL=grok-2
GROK_SECOND_FALLBACK_MODEL=grok-beta

# ------------------------------------------------------------------------------
# Additional AI Providers (Optional Fallbacks)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Local Embeddings (Zero API cost sentence-transformers)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# Storage Provider
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage_data

# ------------------------------------------------------------------------------
# Authentication (Clerk)
# ------------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
